source "$HOME/.config/sketchybar/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top height=40 blur_radius=50 color=$BAR_COLOR \
                  border_color=$ACCENT_COLOR border_width=3 \
                  padding_left=5 padding_right=5 \
                  margin=16 corner_radius=10 \

##### Changing Defaults #####
default=(
  padding_left=8
  padding_right=8
  icon.color=$WHITE
  icon.font="SF Pro:Semibold:14.0"
  label.font="SF Pro:Semibold:12.0"
  label.color=$WHITE
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=6
  label.padding_right=6
)
sketchybar --default "${default[@]}"

##### Adding Left Items #####
source "$CONFIG_DIR/items/apple_logo.sh"
source "$CONFIG_DIR/items/workspaces.sh"
source "$CONFIG_DIR/items/front_app.sh"
source "$CONFIG_DIR/items/vpn.sh"

##### Adding Right Items #####
source "$CONFIG_DIR/items/clock.sh"
source "$CONFIG_DIR/items/bluetooth.sh"
source "$CONFIG_DIR/items/volume.sh"
source "$CONFIG_DIR/items/battery.sh"
source "$CONFIG_DIR/items/wifi.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
